# Copy to .env.local for local dev, or set in your Vercel project settings.
#
# Where the multiplayer game server lives. Leave unset for local play and the
# client falls back to the page's own host on port 3112 (what `npm run dev:all`
# starts). For a deployed site this MUST be a wss:// URL, because an https page
# is not allowed to open a plain ws:// connection.
#
# Example: NEXT_PUBLIC_GAME_SERVER=wss://my-julie-server.onrender.com
NEXT_PUBLIC_GAME_SERVER=
